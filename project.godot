; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Addons]

ButtonPrompts/prompts/light_themed_keyboard_and_mouse=false
ButtonPrompts/prompts/positional_controller_button_prompts=false
ButtonPrompts/optional_supported_controllers/dualshock_4=true
ButtonPrompts/optional_supported_controllers/dualshock_3=true
ButtonPrompts/optional_supported_controllers/xbox_one=true
ButtonPrompts/optional_supported_controllers/xbox_360=true
ButtonPrompts/optional_supported_controllers/steam_deck=true
ButtonPrompts/optional_supported_controllers/nintendo_switch=true

[application]

config/name="Not an Incremental Game"
run/main_scene="uid://b1gudkcbuhjck"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

StatManager="*res://scripts/stat_manager.gd"
button_prompts_manager="*res://addons/button_prompts_for_godot/Scripts/button_prompts_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/basic_shape_creation/plugin.cfg", "res://addons/button_prompts_for_godot/plugin.cfg", "res://addons/gdterm/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

Player="player"

